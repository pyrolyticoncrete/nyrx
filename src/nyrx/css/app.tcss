}
#ep-thumb-spinner {
    width: auto;
    height: 1;
    color: #707070;
    text-align: center;
}
#ep-thumb-loading-label {
    height: 1;
    color: #707070;
    text-align: center;
    width: auto;
}
#ep-thumb-meta-col {
    width: 1fr;
