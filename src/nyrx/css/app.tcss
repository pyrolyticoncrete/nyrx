}

/* ── URLInputModal ───────────────────────────────────────────── */

#url-box {
    width: 60;
    height: auto;
    background: $panel;
    padding: 1 2;
}
#url-heading {
    text-style: bold;
    margin-bottom: 1;
}
#url-input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
}
#url-status {
    height: 1;
}
#url-hint {
    height: 1;
    margin-top: 1;
}

/* ── SearchModal ─────────────────────────────────────────────── */

SearchModal .search-heading {
    height: 1;
    text-style: bold;
    color: white;
    margin-bottom: 1;
}
#search-box {
    width: 52;
    height: auto;
    padding: 1 2;
    background: $panel;
}
#search-input {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
}
#search-hint {
    height: 1;
    margin-top: 1;
    text-align: left;
}
#search-chips {
    height: auto;
    margin-top: 1;
}
.search-chip {
    width: auto;
    height: 1;
    border: none;
    background: #1c1c22;
    color: #606060;
    padding: 0 2;
    margin: 0 1;
    min-width: 0;
}
.search-chip.active {
    color: #0f0f0f;
    background: #d0d0d0;
    text-style: bold;
}
#search-loader {
    width: 100%;
    height: 3;
}
#search-loader.hidden {
    display: none;
}

/* ── TMDbKeyInputModal ──────────────────────────────────────── */

#tmdb-box {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $panel;
}
#tmdb-heading {
    text-style: bold;
    margin-bottom: 1;
}
#tmdb-input-row {
    height: 1;
}
#tmdb-input {
    width: 48;
    height: 1;
    border: none;
    background: transparent;
}
#tmdb-spinner {
    width: 2;
    margin-left: 1;
    height: 1;
}
#tmdb-status {
    height: 1;
    margin-top: 1;
}
#tmdb-hint {
    height: 1;
    margin-top: 1;
}

/* ── ManifestUrlModal ─────────────────────────────────────── */

#url-box {
    width: 80;
    height: auto;
    padding: 1 2;
    background: $panel;
}
#url-heading {
    text-style: bold;
    margin-bottom: 1;
}
#url-input-row {
    height: 1;
    margin-top: 1;
}
#url-input {
    width: 70;
    height: 1;
    border: none;
}
#url-spinner {
    width: 2;
    height: 1;
    margin-left: 1;
}
#url-status {
    height: 1;
    margin-top: 1;
}
#url-hint {
    height: 1;
    margin-top: 1;
}

/* ── QueueModal ──────────────────────────────────────────────── */

#qm-box {
    width: 80;
    height: 65%;
    max-height: 80%;
    padding: 1 2 2 2;
    background: $panel;
}
#qm-heading {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}
#qm-hd-left {
    width: auto;
    height: 1;
}
#qm-hd-right {
    width: 1fr;
    height: 1;
    text-align: right;
}
#qm-pb-heading {
    height: 1;
    padding: 0 1;
    color: $text-disabled;
}
#qm-playback-list {
    height: 1fr;
    background: transparent;
    scrollbar-size: 0 0;
    margin: 0 1;
    border: none;
}
#qm-playback-list .datatable--cursor {
    color: #0f0f0f;
    background: #A277FF;
}
#qm-playback-list.qm-sole .datatable--cursor {
    background: transparent;
    color: #b0b0b0;
}
#qm-footer {
    dock: bottom;
    height: 2;
    padding: 0 1;
    color: $text-disabled;
}

/* ── CollectionBrowser ───────────────────────────────────────── */

#cb-box {
    width: 130;
    height: 65%;
    max-height: 80%;
    padding: 1 2 2 2;
    background: $panel;
}
#cb-panels {
    height: 1fr;
}
#cb-left-panel {
    width: 50;
    min-width: 36;
    height: 1fr;
    border-right: solid #303030;
    padding-right: 1;
}
#cb-right-panel {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}
#cb-header {
    padding: 0 0 1 0;
    text-style: none;
}
#cb-loading {
    height: 1fr;
    width: 100%;
    align: center middle;
}
#cb-loading > BrailleSpinner {
    width: auto;
    height: 1;
    color: #707070;
    text-align: center;
}
#cb-loading > Label {
    height: 1;
    color: #707070;
    text-align: center;
    width: auto;
}
#cb-collection-name {
    dock: top;
    height: 2;
    color: #707070;
    padding: 0 0 1 0;
}
CollectionBrowser DataTable {
    height: 1fr;
    overflow-x: hidden;
    scrollbar-size: 0 0;
    background: transparent;
}
CollectionBrowser DataTable:focus {
    border: none;
    background: transparent;
}
#cb-footer {
    dock: bottom;
    height: 2;
    padding: 1 0 0 1;
    color: $text-disabled;
    text-align: left;
}

/* ── RadioFilterModal ────────────────────────────────────────── */

#fi-wrapper {
    width: 90;
    height: auto;
    max-height: 85%;
    background: $panel;
    padding: 0 2 1 2;
}

#fi-box {
    layout: horizontal;
    height: auto;
    padding: 0;
}

/* left panel */
#fi-left {
    width: 36;
    min-width: 36;
    height: auto;
    min-height: 16;
    padding: 1 2 1 2;
    border-right: solid $surface;
}

#fi-heading {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    layout: horizontal;
}
#fi-hd-left  { width: auto; height: 1; }
#fi-hd-right { width: 1fr; height: 1; text-align: right; }

RadioFilterModal .fi-field-label {
    height: 1;
    color: $text;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0;
}

/* plain name input */
#fi-name {
    border: none;
    background: transparent;
    height: 1;
    padding: 0;
    margin-bottom: 0;
}
#fi-name:focus { border: none; }

/* chip input row */
RadioFilterModal .chip-input-wrap {
    height: 1;
    background: transparent;
    padding: 0;
    border: none;
    layout: horizontal;
}
RadioFilterModal .chip-input-wrap Input {
    border: none;
    background: transparent;
    height: 1;
    padding: 0;
    min-width: 4;
    width: 1fr;
}
RadioFilterModal .chip-input-wrap Input:focus { border: none; background: transparent; }
RadioFilterModal .chip-row { height: 1; width: auto; background: transparent; padding: 0; }

/* suggestion dropdowns */
RadioFilterModal .fi-suggest {
    height: auto;
    max-height: 6;
    display: none;
    background: transparent;
    margin-bottom: 0;
    border: none;
    scrollbar-size: 0 0;
}
RadioFilterModal .fi-suggest > ListItem {
    padding: 0 1;
    height: 1;
    background: transparent;
}
RadioFilterModal .fi-suggest > ListItem.-highlight {
    color: #0f0f0f;
    background: #A277FF;
}

/* footer */
#fi-footer {
    height: 1;
    margin-top: 0;
    padding: 0 2;
    color: $text-disabled;
}

/* right panel */
#fi-right {
    width: 1fr;
    height: auto;
    padding: 1 2 1 2;
}

#fi-active-heading {
    height: 1;
    margin-bottom: 1;
    layout: horizontal;
}
#fi-active-label  { width: auto; height: 1; }
#fi-active-count  { width: 1fr; height: 1; text-align: right; }

RadioFilterModal .fi-section-label {
    height: 1;
    color: $text-disabled;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0;
}

RadioFilterModal .fi-chip-row {
    height: 1;
    width: 1fr;
    layout: horizontal;
    margin-top: 1;
    overflow-x: auto;
    scrollbar-size: 0 0;
}
RadioFilterModal .fi-chip-row > ChipButton {
    height: 1;
    width: auto;
    padding: 0 1;
}
RadioFilterModal .fi-chip-row > ChipButton:focus {
    text-style: reverse;
}

/* ── TVSeriesView ────────────────────────────────────────── */
#tvs-root {
    width: 100%;
    height: 1fr;
    background: #0f0f0f;
}
#tvs-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-size: 0 0;
    background: #0f0f0f;
    padding: 1 2;
}
#tvs-browsing {
    display: none;
    height: 1;
    margin-bottom: 1;
}
.compact #tvs-browsing {
    display: block;
}
#tvs-browsing-sep {
    display: none;
}
.compact #tvs-browsing-sep {
    display: block;
}
.compact #tvs-header {
    display: none;
}
.compact #tvs-sep {
    display: none;
}
#tvs-header {
    height: auto;
    layout: horizontal;
    margin-bottom: 1;
}
#tvs-poster {
    width: auto;
    height: 100%;
    min-height: 10;
}
#tvs-meta {
    width: 1fr;
    height: auto;
    padding-left: 2;
}
#tvs-title {
    height: 1;
    color: #edecee;
    text-style: bold;
}
#tvs-rating {
    height: 1;
    color: #b0b0b0;
}
#tvs-genres {
    height: 1;
    color: #808080;
    margin-bottom: 1;
}
#tvs-overview {
    height: auto;
    max-height: 6;
    color: #808080;
    overflow-y: hidden;
}
#tvs-root .ap-sep {
    height: 1;
    color: #404040;
}
#tvs-season-selector {
    height: auto;
    min-height: 2;
    margin: 1 0 0 0;
}
#tvs-chip-row {
    height: auto;
    layout: horizontal;
    align: left middle;
    overflow-x: auto;
    scrollbar-size: 0 0;
}
#tvs-chip-row > .season-chip {
    height: 1;
    min-width: 0;
    padding: 0 1;
    margin: 0 1 0 0;
    border: none;
    background: #1e1e1e;
    color: #808080;
    text-style: none;
}
#tvs-chip-row > .season-chip:focus {
    background: #a277ff;
    color: black;
    text-style: bold;
}
#tvs-chip-row > .season-chip.active {
    background: #a277ff;
    color: black;
    text-style: bold;
}
#tvs-episodes {
    height: 1fr;
    border: none;
    scrollbar-size: 0 0;
    background: #0f0f0f;
}
#tvs-episodes:focus {
    background-tint: transparent;
}
#tvs-episodes:focus > .datatable--cursor {
    background: #A277FF;
    color: #0f0f0f;
}
#tvs-episodes > .datatable--cursor {
    background: transparent;
    color: initial;
}
#tvs-episode-desc {
    dock: bottom;
    height: 5;
    color: #808080;
    border-top: solid #404040;
    width: 100%;
    padding: 0 2 1 2;
    margin-bottom: 1;
}
#tvs-keybind-bar {
    dock: bottom;
    height: 1;
    padding: 0 2;
    color: #b0b0b0;
    text-align: right;
}
#tvs-switcher {
    height: 1fr;
    width: 100%;
}
#tvs-loading {
    width: 100%;
    height: 100%;
    align: center middle;
    background: #0f0f0f;
}
#tvs-loading > BrailleSpinner {
    width: auto;
    height: 1;
    color: #A277FF;
    text-align: center;
}
#tvs-loading > Static {
    height: 1;
    color: #707070;
    text-align: center;
    width: auto;
}
#tvs-loaded {
    height: 1fr;
    width: 100%;
}
#tvs-episodes-switcher {
    height: 1fr;
}
#tvs-episodes-loading {
    width: 100%;
    height: 100%;
    align: center middle;
}
#tvs-episodes-loading > BrailleSpinner {
    width: auto;
    height: 1;
    color: #A277FF;
    text-align: center;
}
#tvs-episodes-loading > Static {
    height: 1;
    color: #707070;
    text-align: center;
    width: auto;
}

/* --- Notification Toast Overrides --- */
Toast {
    border: round #61d6ff;
    padding: 0 1;
    max-width: 43;
    max-height: 5;
    overflow: hidden;
    background: $panel;
    margin-top: 0;
}
Toast.-warning {
    border: round $warning;
}
Toast.-error {
    border: round $error;
}
ToastHolder {
    background: transparent;
    align-horizontal: right;
}
ToastRack {
    padding: 0 2 1 0;
    dock: bottom;
    overflow-y: auto;
}
